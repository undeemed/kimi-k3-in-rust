+/* LOCAL PATCH, not upstream. macOS pread() rejects any request >= 2^31 with EINVAL
+ * rather than returning short, so a 2.35 GB tensor (embed_tokens, lm_head at
+ * vocab 163840 x hidden 7168 x bf16) fails at offset 0 and the checkpoint cannot be
+ * loaded at all. Cap every request; every pread here already sits in a loop that
+ * handles a short return. Applied only to compare against the Rust port on real
+ * weights on this machine. */
+#define K3_PREAD_CAP ((size_t)0x7ffff000)
+static size_t k3_cap_(int64_t n) { return (size_t)n > K3_PREAD_CAP ? K3_PREAD_CAP : (size_t)n; }
